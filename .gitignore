# Fish runtime state — written automatically by the shell
.config/fish/fish_variables

# Work git identity — contains work email, keep local only
.gitconfig-work

# Secrets / credentials — never commit these
.netrc
*_auth_token*
*secret*
*credentials*

# OS noise
.DS_Store
Thumbs.db

# Editor swap/undo files
*.swp
*.swo
*~
