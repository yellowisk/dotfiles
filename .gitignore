.config/fish/fish_variables

# Work git identity — contains work email, keep local only
.gitconfig-work

# Secrets / credentials — never commit these
.netrc
*_auth_token*
*secret*
*credentials*

# DMS config-migration backups (auto-generated, local only)
.config/hypr/.dms-backups/

# OS noise
.DS_Store
Thumbs.db

# Editor swap/undo files
*.swp
*.swo
*~
